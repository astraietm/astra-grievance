# ASTRA IETM Confidential Grievance Portal Environment Variables

# Database Connection (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/astra_grievance?schema=public"

# NextAuth Secret Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="astra_super_secret_jwt_key_2026_change_in_production"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Allowed Google Workspace Domain (Optional restriction, e.g. kmct.edu.in or astraietm.in. Leave blank for any Google user)
GOOGLE_ALLOWED_DOMAIN=""

# Development Login Bypass (Set to "false" in production to enforce Google OAuth only)
ENABLE_DEV_LOGIN="true"
