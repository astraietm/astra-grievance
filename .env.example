# ASTRA IETM Confidential Grievance Portal Environment Variables (Supabase + Vercel)

# Supabase PostgreSQL Connection Strings
# 1. DATABASE_URL: Supabase Transaction Pooler URL (Port 6543) - Recommended for Vercel Serverless Functions
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Database Connection URL (Port 5432) - Used for Prisma CLI migrations & Vercel builds
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Project Credentials (API & Storage)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="grievance-attachments"

# NextAuth Secret Configuration
NEXTAUTH_URL="https://your-app-name.vercel.app" # Set to your deployed Vercel domain or localhost for dev
NEXTAUTH_SECRET="astra_super_secret_jwt_key_2026_change_in_production"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Allowed Google Workspace Domain (Optional restriction, e.g. kmct.edu.in or astraietm.in. Leave blank for any Google user)
GOOGLE_ALLOWED_DOMAIN=""

# Development Login Bypass (Set to "false" in Vercel production deployment)
ENABLE_DEV_LOGIN="true"

# Resend Email Configuration
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="ASTRA Grievance Portal <onboarding@resend.dev>"

